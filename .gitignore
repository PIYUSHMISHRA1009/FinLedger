# FinLedger - Git Ignore Rules

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment files
.env
.env.local
.env.*.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Distribution / Packaging
dist/
build/
*.egg-info/
*.egg

# Logs
*.log
logs/

# Database
*.sqlite
*.db

# Docker
.docker/

# Terraform
*.tfstate
*.tfstate.*
.terraform/

# Kubernetes
kubeconfig

# Secrets (never commit!)
*.pem
*.key
*.crt
secrets/

# Jupyter Notebook
.ipynb_checkpoints/

# Temporary files
*.tmp
*.temp
tmp/

# Coverage reports
coverage.xml
coverage.json

# Type checking
.mypy_cache/
.pyre/

# IDE specific
.project
.classpath
.settings/

# Node modules (if any frontend)
node_modules/

# Python package cache
.pip_cache/

# Backup files
*.bak
*.backup

# Celery
celerybeat-schedule
celerybeat.pid

# Prometheus
prometheus_data/

# Grafana
grafana_data/

# PostgreSQL
postgres_data/

# Redis
redis_data/

# Local development overrides
docker-compose.override.yml
.env.development.local